    {
      "name": "wallets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallets\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"currency\" TEXT NOT NULL, \"opening_balance_minor\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"created_on\" TEXT NOT NULL, \"has_transactions\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_transactions\" IN (0, 1)), \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"server_updated_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
